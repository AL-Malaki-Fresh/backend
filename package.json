{
  "name": "almalaki-backend",
  "version": "1.0.0",
  "description": "Al Malaki Fresh Backend API",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:studio": "npx prisma studio",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:generate": "npx prisma generate",
    "seed": "node prisma/seed.js",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:restart": "docker-compose down && docker-compose up -d",
    "docker:clean": "docker-compose down -v && docker-compose up -d",
    "docker:bash": "docker exec -it almalaki-backend sh",
    "docker:migrate": "docker exec -it almalaki-backend npx prisma migrate deploy",
    "docker:studio": "docker exec -it almalaki-backend npx prisma studio --hostname 0.0.0.0 --port 5555"
  },
  "keywords": [
    "ecommerce",
    "api",
    "express",
    "postgresql"
  ],
  "author": "Al Malaki Fresh",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "prisma": "^7.8.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
