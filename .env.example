# Copy this file to .env and fill in real values.
# Only placeholder/example values below — no real secrets.

# ── Required — the app refuses to start without these ──────────────────────
PORT=5001
NODE_ENV="development"

DATABASE_URL="postgresql://postgres:your-password@localhost:5433/almalaki"

# Two separate secrets now (this used to be a single JWT_SECRET — that name
# no longer works).
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"

# Tap Payments (business.tap.company → Developers → API Keys). The app
# validates these at startup and will not boot without them, even if you're
# not testing payments yet.
TAP_SECRET_KEY="replace-with-your-tap-test-secret-key"
TAP_MERCHANT_ID="your-tap-merchant-id"
# Where Tap redirects the customer after payment — must be a real http(s)
# URL, not localhost, and must match what the mobile app's payment WebView
# expects.
TAP_RETURN_URL="https://your-domain.example.com/payment-result"

# ── Optional — sensible defaults if omitted ─────────────────────────────────
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Your admin dashboard's URL, allowed by CORS. Defaults to
# http://localhost:5173 if unset.
ADMIN_FRONTEND_URL="http://localhost:5173"

# Comma-separated extra origins allowed by CORS, beyond ADMIN_FRONTEND_URL
# and the built-in localhost defaults.
CORS_EXTRA_ORIGINS=""

# Cloudinary (cloudinary.com → free plan is enough for this app). Dashboard
# → your account name/API keys are on the Cloudinary console home page.
# Without these, the app still boots fine — only POST /api/admin/uploads/
# product-image will fail with a clear 500 until they're set.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

TAP_CURRENCY="QAR"
# Server-to-server payment confirmation. Only used if it's a public https://
# URL — Tap can't reach localhost. Once deployed:
# https://<your-backend-domain>/api/mobile/payments/tap-webhook
TAP_WEBHOOK_URL=""

# Only needed if you run `npx prisma db seed` against a database where
# NODE_ENV=production — otherwise the seed script refuses to run.
ALLOW_PROD_SEED="false"

# ── Only used by docker-compose.yml for local Postgres/pgAdmin containers —
# not read directly by the app, and irrelevant on Render (which provides its
# own managed Postgres and its own DATABASE_URL). ─────────────────────────
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your-password"
POSTGRES_DB="almalaki"
PGADMIN_DEFAULT_EMAIL="admin@almalaki.com"
PGADMIN_DEFAULT_PASSWORD="your-pgadmin-password"
